CCEffect %{
  techniques:
  - passes:
    - vert: light-shaft-vs
      frag: light-shaft-prefilter-fs
      pass: cc-light-shaft-prefilter
      rasterizerState: &rasterizerState
        cullMode: none
      depthStencilState: &depthStencilState
        depthTest: false
        depthWrite: false
    - vert: light-shaft-vs
      frag: light-shaft-blur-fs
      pass: cc-light-shaft-blur
      rasterizerState: *rasterizerState
      depthStencilState: *depthStencilState
    - vert: light-shaft-vs
      frag: light-shaft-combine-fs
      pass: cc-light-shaft-combine
      rasterizerState: *rasterizerState
      depthStencilState: *depthStencilState
}%

CCProgram light-shaft-vs %{
  #include <./chunks/vs1>
}%

CCProgram light-shaft-ubo %{
  #pragma rate LightShaftUBO pass
  uniform LightShaftUBO {
    vec4 lightShaftSource; // xy: source UV, z: radius, w: viewport aspect ratio
    vec4 lightShaftParams; // x: linear threshold, y: intensity, z: length, w: samples
    vec4 lightShaftTint; // rgb: linear tint
    vec4 lightShaftTexelSize; // xy: inverse input size
  };
}%

CCProgram light-shaft-prefilter-fs %{
  precision highp float;
  #include <common/color/gamma>
  #include <light-shaft-ubo>

  #pragma rate sceneColorMap pass
  uniform sampler2D sceneColorMap;

  in vec2 v_uv;
  layout(location = 0) out vec4 fragColor;

  vec3 SampleLinearSource (vec2 uv) {
    vec4 color = texture(sceneColorMap, clamp(uv, vec2(0.0), vec2(1.0)));
    // Transparent clears can contain nonzero RGB; they must not emit shafts.
    if (color.a <= 0.00001) {
      return vec3(0.0);
    }
    #if !CC_USE_FLOAT_OUTPUT
      color.rgb = SRGBToLinear(color.rgb);
    #endif
    return max(color.rgb, vec3(0.0));
  }

  void main () {
    vec2 halfTexel = lightShaftTexelSize.xy * 0.5;
    vec3 color = SampleLinearSource(v_uv + vec2(-halfTexel.x, -halfTexel.y));
    color += SampleLinearSource(v_uv + vec2(halfTexel.x, -halfTexel.y));
    color += SampleLinearSource(v_uv + vec2(-halfTexel.x, halfTexel.y));
    color += SampleLinearSource(v_uv + halfTexel);
    color *= 0.25;

    float brightness = dot(color, vec3(0.2126, 0.7152, 0.0722));
    float threshold = max(lightShaftParams.x, 0.0);
    float knee = max(threshold * 0.5, 0.0001);
    float soft = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee);
    float contribution = max(soft, brightness - threshold) / max(brightness, 0.0001);

    vec2 sourceOffset = v_uv - lightShaftSource.xy;
    sourceOffset.x *= max(lightShaftSource.w, 0.0001);
    float radius = max(lightShaftSource.z, 0.0001);
    float sourceMask = 1.0 - smoothstep(radius * 0.5, radius, length(sourceOffset));
    vec3 shaft = color * contribution * sourceMask;
    // Gamma compression preserves dark shaft detail in the LDR RGBA8 intermediate.
    #if !CC_USE_FLOAT_OUTPUT
      shaft = LinearToSRGB(shaft);
    #endif
    fragColor = vec4(shaft, 1.0);
  }
}%

CCProgram light-shaft-blur-fs %{
  precision highp float;
  precision mediump int;
  #include <common/color/gamma>
  #include <light-shaft-ubo>

  #pragma rate lightShaftMap pass
  uniform sampler2D lightShaftMap;

  in vec2 v_uv;
  layout(location = 0) out vec4 fragColor;

  vec3 SampleShaft (vec2 uv) {
    // Zero beyond the image instead of extending border texels into long rays.
    vec2 inside = step(vec2(0.0), uv) * step(uv, vec2(1.0));
    vec3 shaft = texture(lightShaftMap, clamp(uv, vec2(0.0), vec2(1.0))).rgb;
    #if !CC_USE_FLOAT_OUTPUT
      shaft = SRGBToLinear(shaft);
    #endif
    return shaft * inside.x * inside.y;
  }

  void main () {
    float sampleCount = clamp(floor(lightShaftParams.w), 1.0, 32.0);
    float intervals = max(sampleCount - 1.0, 1.0);
    vec2 delta = (lightShaftSource.xy - v_uv) * clamp(lightShaftParams.z, 0.0, 1.0) / intervals;
    // Keep the endpoint and its half-strength weight identical across quality levels.
    float decay = exp2(-1.0 / intervals);
    vec2 sampleUV = v_uv;
    vec3 sum = vec3(0.0);
    float weight = 1.0;
    float totalWeight = 0.0;
    // Constant loop bound keeps the shader usable on mobile GLSL targets.
    for (int i = 0; i < 32; ++i) {
      if (float(i) >= sampleCount) {
        break;
      }
      sum += SampleShaft(sampleUV) * weight;
      totalWeight += weight;
      sampleUV += delta;
      weight *= decay;
    }
    vec3 shaft = sum / max(totalWeight, 0.0001);
    #if !CC_USE_FLOAT_OUTPUT
      shaft = LinearToSRGB(max(shaft, vec3(0.0)));
    #endif
    fragColor = vec4(shaft, 1.0);
  }
}%

CCProgram light-shaft-combine-fs %{
  precision highp float;
  #include <common/color/gamma>
  #include <light-shaft-ubo>

  #pragma rate sceneColorMap pass
  uniform sampler2D sceneColorMap;
  #pragma rate lightShaftMap pass
  uniform sampler2D lightShaftMap;

  in vec2 v_uv;
  layout(location = 0) out vec4 fragColor;

  void main () {
    vec4 sceneColor = texture(sceneColorMap, v_uv);
    if (sceneColor.a <= 0.00001) {
      fragColor = vec4(0.0, 0.0, 0.0, sceneColor.a);
      return;
    }
    #if !CC_USE_FLOAT_OUTPUT
      sceneColor.rgb = SRGBToLinear(sceneColor.rgb);
    #endif
    vec3 shaft = texture(lightShaftMap, v_uv).rgb;
    #if !CC_USE_FLOAT_OUTPUT
      shaft = SRGBToLinear(shaft);
    #endif
    sceneColor.rgb += shaft * max(lightShaftTint.rgb, vec3(0.0)) * max(lightShaftParams.y, 0.0);
    #if !CC_USE_FLOAT_OUTPUT
      sceneColor.rgb = LinearToSRGB(max(sceneColor.rgb, vec3(0.0)));
    #endif
    fragColor = sceneColor;
  }
}%
