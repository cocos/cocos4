CCEffect %{
  techniques:
  - passes:
    - compute: cluster-build-comp
      pass: cluster-build
}%

CCProgram cluster-build-comp %{
  precision highp float;
  precision highp int;
  #include <pipeline/cluster/constants>
  layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
  #pragma rate b_clusters pass
  layout(std430) writeonly buffer b_clusters { vec4 b_clustersData[]; };

  vec3 unproject(vec2 uv, float z) {
    vec4 p = cc_clusterProjInv * vec4(uv * 2.0 - 1.0, z, 1.0);
    return p.xyz / p.w;
  }
  vec3 atDepth(vec2 uv, float depth) {
    vec3 a = unproject(uv, cc_clusterCamera.w);
    vec3 b = unproject(uv, 1.0);
    // 射线与 viewZ=-depth 平面求交，透视和正交共用，不能假设射线始于相机原点。
    return a + (b - a) * ((-depth - a.z) / (b.z - a.z));
  }
  void main() {
    uvec3 id = gl_GlobalInvocationID;
    uint index = id.x + 16u * (id.y + 8u * id.z);
    float nearDepth = cc_clusterCamera.x * pow(cc_clusterCamera.y / cc_clusterCamera.x, float(id.z) / 24.0);
    float farDepth = cc_clusterCamera.x * pow(cc_clusterCamera.y / cc_clusterCamera.x, float(id.z + 1u) / 24.0);
    vec2 uv0 = vec2(id.xy) / vec2(16.0, 8.0);
    vec2 uv1 = vec2(id.xy + uvec2(1u)) / vec2(16.0, 8.0);
    vec3 lo = vec3(1.0e30);
    vec3 hi = vec3(-1.0e30);
    for (int y = 0; y < 2; ++y) {
      for (int x = 0; x < 2; ++x) {
        vec2 uv = vec2(x == 0 ? uv0.x : uv1.x, y == 0 ? uv0.y : uv1.y);
        vec3 a = atDepth(uv, nearDepth);
        vec3 b = atDepth(uv, farDepth);
        lo = min(lo, min(a, b));
        hi = max(hi, max(a, b));
      }
    }
    b_clustersData[index * 2u] = vec4(lo, 0.0);
    b_clustersData[index * 2u + 1u] = vec4(hi, 0.0);
  }
}%
